# Positions
logo_h_alignment        = 0.5;
logo_v_alignment        = 0.5;
logo_fade_delay         = 0;
logo_fade_duration      = 20;

progress_h_alignment    = 0.5;
progress_v_alignment    = 0.87;
progress_fade_delay      = 20;
progress_fade_duration   = 20;

spinner_h_alignment     = 0.5;
spinner_v_alignment     = 0.75;
spinner_fade_delay      = 20;
spinner_fade_duration   = 20;
spinner_max_opacity     = 0.3;

message_h_alignment     = 0.5;
message_v_alignment     = 0.9;
message_font_size       = 18;

#----------------------------------------- Logo --------------------------------
# Best for multi-device: 800px or 1280px master logo.png
unscaled_logo = Image("logo.png");

screen_w = Window.GetWidth();
screen_h = Window.GetHeight();

# Force target width to an integer (40% of screen)
target_w = Math.Int(screen_w * 0.40);
logo_scale_factor = target_w / unscaled_logo.GetWidth();

# Force height to an integer to prevent aliasing
target_h = Math.Int(unscaled_logo.GetHeight() * logo_scale_factor);

# Scale and create sprite using whole numbers
logo.image = unscaled_logo.Scale(target_w, target_h);
logo.sprite = Sprite(logo.image);

# Center perfectly on pixel boundaries
logo.sprite.SetX(Math.Int(screen_w / 2 - logo.image.GetWidth() / 2));
logo.sprite.SetY(Math.Int(screen_h / 2 - logo.image.GetHeight() / 2));

logo_time = 0;
logo_opacity = 0;

fun show_logo(fade) {
    if (fade) {
        if (logo_time < logo_fade_delay) {
            logo_time ++;
        }
        else {
            if (logo_opacity < 1) {
                logo_opacity = logo_opacity + 1/logo_fade_duration;
            }
            logo.sprite.SetOpacity(logo_opacity);
        }
    }
    else {
        logo.sprite.SetOpacity(1);
    }
}

fun hide_logo() {
    logo_time = 0;
    logo_opacity = 0;
    logo.sprite.SetOpacity(logo_opacity);
}

#----------------------------------------- Spinner --------------------------------
for (i = 0; i < 30; i++)
  spinner.images[i] = Image("spinner-" + i + ".png");

spinner.sprite = Sprite();

# Use Math.Int for spinner positioning
spinner.sprite.SetX(Math.Int(screen_w * spinner_h_alignment - spinner.images[0].GetWidth() / 2));
spinner.sprite.SetY(Math.Int(screen_h * spinner_v_alignment - spinner.images[0].GetHeight() / 2));

fun refresh_spinner() {
    spinner.sprite.SetImage(spinner.images[Math.Int(progress / 2) % 30]);
}

spinner_time = 0;
spinner_opacity = 0;
fun show_spinner() {
    if (spinner_time < spinner_fade_delay) {
        spinner_time ++;
    }
    else {
        if (spinner_opacity < spinner_max_opacity) {
            spinner_opacity = spinner_opacity + spinner_max_opacity/spinner_fade_duration;
        }
        spinner.sprite.SetOpacity(spinner_opacity);
    }
}

fun hide_spinner() {
    spinner_time = 0;
    spinner_opacity = 0;
    spinner.sprite.SetOpacity(spinner_opacity);
}

#----------------------------------------- Refresh --------------------------------
progress = 0;
fun refresh_callback () {
    progress++;
    refresh_spinner();
}
Plymouth.SetRefreshFunction (refresh_callback);

#----------------------------------------- Progress Bar --------------------------------
progress_box.image = Image("progress_box.png");
progress_box.sprite = Sprite(progress_box.image);

# Align progress box to whole pixels
progress_box.x = Math.Int(screen_w * progress_h_alignment - progress_box.image.GetWidth() / 2);
progress_box.y = Math.Int(screen_h * progress_v_alignment - progress_box.image.GetHeight() / 2);
progress_box.sprite.SetPosition(progress_box.x, progress_box.y, 0);

progress_bar.original_image = Image("progress_bar.png");
progress_bar.sprite = Sprite();

# Align progress bar to whole pixels
progress_bar.x = Math.Int(screen_w * progress_h_alignment - progress_bar.original_image.GetWidth() / 2);
progress_bar.y = Math.Int(screen_h * progress_v_alignment - progress_box.image.GetHeight() / 2 + (progress_box.image.GetHeight() - progress_bar.original_image.GetHeight()) / 2);
progress_bar.sprite.SetPosition(progress_bar.x, progress_bar.y, 1);

fun show_progress() {
    progress_box.sprite.SetOpacity(1);
    progress_bar.sprite.SetOpacity(1);
}

fun hide_progress() {
    progress_box.sprite.SetOpacity(0);
    progress_bar.sprite.SetOpacity(0);
}

#----------------------------------------- Boot --------------------------------
hide_progress();
hide_spinner();

fun boot_callback (duration, progress) {
    if (Plymouth.GetMode() == "boot") {
        hide_progress();
        show_spinner();
        show_logo(1);
    }
    else if (Plymouth.GetMode() == "shutdown") {
        show_spinner();
        show_logo(1);
    }
}

Plymouth.SetBootProgressFunction(boot_callback);

